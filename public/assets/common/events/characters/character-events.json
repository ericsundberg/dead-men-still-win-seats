    {
      "id": "event_characters_01",
      "title": "The Podium Has a Pulse",
      "description": "During rehearsal, two volunteers swear Senator Buster blinked while strapped behind the campaign podium. A television crew now wants a live close-up.",
      "trigger": {
        "type": "chance",
        "chancePercent": 25
      },
      "repeatable": false,
      "decisions": [
        {
          "id": "decision_prerecord_podium_speech",
          "label": "Produce a prerecorded speech and synchronize the podium lights to it.",
          "requirements": {
            "minimumCash": 5000,
            "minimumActionPoints": 1
          },
          "effects": {
            "cash": -5000,
            "actionPoints": -1,
            "publicSuspicion": 5,
            "partyConfidence": 2,
            "voterEnergy": 3
          },
          "addFlags": [
            "flag_podium_speech_prerecorded"
          ],
          "newsItems": [
            {
              "headline": "Buster Delivers Perfectly Timed Address from Custom Podium",
              "category": "campaign"
            }
          ]
        },
        {
          "id": "decision_keep_camera_wide",
          "label": "Allow the speech, but require every camera to remain fifty feet away.",
          "requirements": {
            "minimumActionPoints": 1
          },
          "effects": {
            "actionPoints": -1,
            "publicSuspicion": 3,
            "partyConfidence": 1,
            "voterEnergy": -1
          },
          "addFlags": [
            "flag_podium_camera_distance"
          ],
          "newsItems": [
            {
              "headline": "Buster Campaign Imposes Unusually Wide Camera Angles",
              "category": "campaign"
            }
          ]
        },
        {
          "id": "decision_blame_podium_lighting",
          "label": "Say the apparent blinking was caused by faulty stage lighting.",
          "effects": {
            "publicSuspicion": 6,
            "partyConfidence": -1
          },
          "addFlags": [
            "flag_podium_blink_lighting"
          ],
          "newsItems": [
            {
              "headline": "Campaign Blames Lighting Rig for Reports Senator Blinked",
              "category": "campaign"
            }
          ]
        },
        {
          "id": "decision_cancel_podium_event",
          "label": "Cancel the appearance and blame a scheduling conflict.",
          "effects": {
            "publicSuspicion": 4,
            "partyConfidence": -3,
            "voterEnergy": -3
          },
          "addFlags": [
            "flag_podium_event_cancelled"
          ],
          "newsItems": [
            {
              "headline": "Buster Cancels Podium Appearance Minutes Before Broadcast",
              "category": "campaign"
            }
          ]
        }
      ],
      "imagePath": "characters/buster-at-the-podium.webp"
