# Dependencies
node_modules/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
.yarn-cache/

# Build output
dist/
build/
out/
.cache/
.parcel-cache/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Test / coverage output
coverage/
.nyc_output/

# Local game/editor exports
*.local
*.bak

# Screenshots and recordings
screenshots/
recordings/
captures/

# Large raw source assets
# Keep exported, optimized game assets in the repo.
# Put huge originals, PSDs, AEPs, WAV masters, etc. elsewhere unless intentionally tracked.
*.psd
*.psb
*.ai
*.aep
*.wav
*.flac

# Do not ignore common web-ready assets:
# *.png
# *.jpg
# *.jpeg
# *.webp
# *.ogg
# *.mp3
# *.json
